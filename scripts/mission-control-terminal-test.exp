#!/usr/bin/expect -f

set timeout 15
set project [file normalize [file join [file dirname [info script]] ..]]
set stateRoot [file join /tmp "bridge-mc-terminal-[pid]"]
file mkdir $stateRoot
proc fail {stateRoot} {
  file delete -force $stateRoot
  exit 1
}

spawn /bin/zsh -f
send -- "cd '$project'; before=\$(stty -g); node scripts/mission-control.mjs --state-root '$stateRoot' --refresh-ms 250; result=\$?; after=\$(stty -g); if \[\[ \"\$before\" == \"\$after\" \]\]; then echo TERMINAL_OK:\$result; else echo TERMINAL_BAD:\$result; fi; echo INPUT_OK\r"
expect "AGENT BRIDGE MISSION CONTROL"
expect "QUOTA"
expect "1:active"
after 100
send -- "\t"
expect "Focused details pane."
send -- "z"
expect "Zoomed details pane."
send -- "\t"
expect "Focus remains on details pane."
send -- "+"
expect "Resized details pane."
send -- "d"
expect "Detached details pane. Focused work pane."
send -- "D"
expect "Reattached details pane."
send -- "6"
expect -exact {[6:history]}
send -- "s"
expect -exact {[2:needs you]}
after 100
set quitStarted [clock milliseconds]
send -- "q"
expect {
  -exact "\033\[?25h\033\[?1049l" {}
  timeout { fail $stateRoot }
  eof { fail $stateRoot }
}
expect {
  "TERMINAL_OK:0" {}
  "TERMINAL_BAD:" { fail $stateRoot }
  timeout { fail $stateRoot }
  eof { fail $stateRoot }
}
expect "INPUT_OK"
if {[expr {[clock milliseconds] - $quitStarted}] >= 1000} { fail $stateRoot }
send -- "exit\r"
expect eof
file delete -force $stateRoot
